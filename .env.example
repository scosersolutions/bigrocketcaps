# Copia de .env.example. NUNCA se sube al repo (esta en .gitignore).

# --- SEC EDGAR ---
# La SEC no pide clave, pero exige un User-Agent identificativo con un correo
# REAL: es el buzon al que avisan antes de cortar el acceso si ven un patron
# raro de descargas. Con uno inventado no hay aviso previo, hay bloqueo.
# Limite: 10 peticiones por segundo contando TODAS tus maquinas.
MR_SEC_USER_AGENT=BigRocketCaps/0.1 (tu@correo-real)

# --- Hugging Face ---
# Solo hace falta para subir el lago. El dataset va PRIVADO: lleva precios
# derivados de Yahoo y sus terminos prohiben redistribuirlos.
HF_TOKEN=

# --- Entorno ---
MR_ENV=dev
MR_DATA_DIR=./data
MR_LOG_DIR=./logs
MR_LOG_LEVEL=INFO
